# Backend (uvicorn --env-file ../.env). Leave unset to use the built-in static tool list.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ROAS preset source — private sheet, keyless: backend impersonates this service
# account via local ADC (share the sheet with this email as Viewer).
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=toolhub-sheets@toolhub-505111.iam.gserviceaccount.com
# Or on hosts without gcloud ADC, use a key file instead:
# GOOGLE_APPLICATION_CREDENTIALS=./backend/secrets/toolhub-sa.json
